# ==================================================
# Easkoy Railway Configuration
# ==================================================

# --------------------------------------------------
# Reality
# --------------------------------------------------

# Optional.
# If Railway TCP Proxy is configured,
# RAILWAY_TCP_APPLICATION_PORT is used automatically.

REALITY_LISTEN_PORT=443

# Reality handshake target.
# Must be a real HTTPS server reachable on TCP/443.

REALITY_SNI=www.microsoft.com


# --------------------------------------------------
# WebSocket
# --------------------------------------------------

# Railway HTTP public networking port.

PORT=8080

# WebSocket path.

WS_PATH=/easkoy-ws
