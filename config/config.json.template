{
  "log": {
    "level": "info",
    "timestamp": true
  },

  "inbounds": [

    {
      "type": "vless",
      "tag": "easkoy-reality",

      "listen": "0.0.0.0",
      "listen_port": ${REALITY_LISTEN_PORT},

      "users": [
        {
          "uuid": "${UUID}",
          "flow": "xtls-rprx-vision"
        }
      ],

      "tls": {
        "enabled": true,

        "server_name": "${REALITY_SNI}",

        "reality": {
          "enabled": true,

          "handshake": {
            "server": "${REALITY_SNI}",
            "server_port": 443
          },

          "private_key": "${PRIVATE_KEY}",

          "short_id": [
            "${SHORT_ID}"
          ]
        }
      }
    },


    {
      "type": "vless",
      "tag": "easkoy-ws",

      "listen": "0.0.0.0",
      "listen_port": ${WS_LISTEN_PORT},

      "users": [
        {
          "uuid": "${UUID}"
        }
      ],

      "transport": {
        "type": "ws",
        "path": "${WS_PATH}"
      }
    }

  ],

  "outbounds": [

    {
      "type": "direct",
      "tag": "direct"
    }

  ]
}
